{
  pkgs,
  lib,
  config,
  ...
}: let
  inherit (lib) mkIf mkEnableOption;

  cfg = config.sv.app-wrapper;

  # Shared by app-run-local and run-on-android-phone: build, sync, point the WebView at the local server and install
  installLocal =
    /*
    bash
    */
    ''
      set -euo pipefail

      appPort="''${APP_PORT:-8000}"
      vitePort="''${VITE_PORT:-5173}"
      localUrl="http://localhost:$appPort"
      applicationId=$(grep -oP 'applicationId\s+"\K[^"]+' android/app/build.gradle)

      npm run build
      npx cap sync android

      # Only the generated (gitignored) copy of capacitor.config.json is changed, the tracked one stays as it is
      generatedConfig=android/app/src/main/assets/capacitor.config.json
      jq \
        --arg url "$localUrl" \
        --arg clientId "''${LOCAL_CLIENT_ID:-}" \
        '.server.url = "\($url)/home"
        | .server.cleartext = true
        | .plugins.BesteSchuleBridge.baseUrl = $url
        | if $clientId != "" then .plugins.BesteSchuleBridge.clientId = $clientId else . end' \
        "$generatedConfig" > "$generatedConfig.tmp"
      mv "$generatedConfig.tmp" "$generatedConfig"

      # localhost on the device is forwarded to the host, so APP_URL works unchanged
      adb wait-for-device
      adb reverse "tcp:$appPort" "tcp:$appPort"
      adb reverse "tcp:$vitePort" "tcp:$vitePort"

      (cd android && ./gradlew installDebug)
      adb shell monkey -p "$applicationId" -c android.intent.category.LAUNCHER 1 > /dev/null
      echo "> Running against $localUrl, inspect the WebView at chrome://inspect"
    '';
in {
  options.sv.app-wrapper = {
    enable = mkEnableOption "development environment for a native app that wraps a web app in a WebView (Capacitor)";
    flavor = lib.mkOption {
      type = with lib.types; nullOr (enum ["beste"]);
      default = null;
      description = "The flavor of the app wrapper configuration to use";
    };
    avd = {
      name = lib.mkOption {
        type = lib.types.str;
        default = "sv-app";
        description = "Name of the Android Virtual Device created by `emulator-start`";
      };
      apiLevel = lib.mkOption {
        type = lib.types.str;
        default = "36";
        description = "API level of the emulator system image";
      };
    };
  };
  config = mkIf cfg.enable {
    sv.extraWelcomeText =
      if cfg.flavor != null
      then "**Flavor:** `${cfg.flavor}`"
      else "";

    # generated by the devenv android integration
    sv.gitExclude = [".android" "local.properties"];

    languages.javascript = {
      enable = true;
      package = pkgs.nodejs_24;
      npm.enable = true;
    };

    # Versions match android/variables.gradle and android/app/capacitor.build.gradle
    languages.java.jdk.package = pkgs.jdk21;

    android = {
      enable = true;
      platforms.version = [cfg.avd.apiLevel];
      # the default of the Android Gradle Plugin, gradle does not pin a version
      buildTools.version = ["35.0.0"];
      systemImageTypes = ["google_apis"];
      abis = ["x86_64"];
      emulator.enable = true;
      systemImages.enable = true;
      ndk.enable = false;
      cmake.version = [];
      googleTVAddOns.enable = false;
      android-studio.enable = true;
    };

    env.CAPACITOR_ANDROID_STUDIO_PATH = lib.getExe config.android.android-studio.package;

    assertions = [
      {
        assertion = pkgs.config.allowUnfree;
        message = "`allowUnfree` is not enabled but for Android development unfree packages are needed. Set `allowUnfree: true` in your devenv.yaml";
      }
    ];

    scripts = {
      emulator-start = {
        description = ''
          Starts the Android emulator (creates the AVD `${cfg.avd.name}` on first use).
        '';
        exec =
          /*
          bash
          */
          ''
            set -euo pipefail
            if ! avdmanager list avd -c | grep -qxF "${cfg.avd.name}"; then
              echo no | avdmanager create avd \
                --name "${cfg.avd.name}" \
                --package "system-images;android-${cfg.avd.apiLevel};google_apis;x86_64" \
                --device pixel_7
            fi
            # avdmanager disables the hardware keyboard, without it typing on the host does nothing in the emulator
            sed -i 's/^hw\.keyboard *=.*/hw.keyboard = yes/' "$ANDROID_AVD_HOME/${cfg.avd.name}.avd/config.ini"
            # the android integration puts build-tools/lib64 on LD_LIBRARY_PATH, its libc++ breaks the emulator
            nohup env -u LD_LIBRARY_PATH emulator -avd "${cfg.avd.name}" -no-snapshot-save > "$ANDROID_USER_HOME/emulator.log" 2>&1 &
            echo "> Emulator starting, log: $ANDROID_USER_HOME/emulator.log"
          '';
      };
      app-run-local = {
        description = ''
          Builds the app, points it at the local server (`APP_PORT`, `LOCAL_CLIENT_ID`) and runs it on the emulator.
        '';
        exec = ''
          export ANDROID_SERIAL="''${ANDROID_SERIAL:-$(adb devices | awk 'NR > 1 && $2 == "device" && $1 ~ /^emulator-/ { print $1; exit }')}"
          if [ -z "$ANDROID_SERIAL" ]; then
            echo "> No running emulator found, start one with emulator-start"
            exit 1
          fi
          ${installLocal}
        '';
      };
      run-on-android-phone = {
        description = ''
          Same as `app-run-local`, but on a phone connected with USB debugging (see `adb devices`).
        '';
        exec = ''
          export ANDROID_SERIAL="''${ANDROID_SERIAL:-$(adb devices | awk 'NR > 1 && $2 == "device" && $1 !~ /^emulator-/ { print $1; exit }')}"
          if [ -z "$ANDROID_SERIAL" ]; then
            echo "> No phone found with adb devices"
            exit 1
          fi
          ${installLocal}
        '';
      };
    };
  };
}
